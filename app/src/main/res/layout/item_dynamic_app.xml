<?xml version="1.0" encoding="utf-8"?>
<!-- ListView 会忽略 item 根布局的 margin，所以间距必须用外层 padding 来做。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/itemCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_picker_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingTop="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/itemIcon"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="icon"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#FF111111"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemPackage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="#FF8A8A8A"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/itemBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_picker_badge"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp"
            android:text="推荐应用"
            android:textColor="#FF3D6DFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/itemCheck"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_picker_check_off"
            android:contentDescription="check" />
    </LinearLayout>
</FrameLayout>
